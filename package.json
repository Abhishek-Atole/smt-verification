{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:renderer": "pnpm --filter \"./artifacts/feeder-scanner\" run build",
    "build:server": "pnpm --filter \"./artifacts/api-server\" run build",
    "build:all": "pnpm run build:renderer && pnpm run build:server",
    "start:server": "node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./feeder-verification\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "@esbuild-kit/esm-loader>esbuild": "0.25.12",
      "postcss": "^8.5.25",
      "uuid": "14.0.0",
      "ip-address": ">=10.3.1",
      "body-parser": "^2.3.0",
      "markdown-it": "^14.2.0",
      "@babel/core": "^7.29.6",
      "js-yaml": "^4.3.0",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "undici@6": "^6.28.0",
      "undici@7": "^7.29.0",
      "dompurify": "^3.4.12",
      "fast-uri": "^3.1.5",
      "tmp": "^0.2.6",
      "form-data": "^4.0.6",
      "qs": "^6.15.2",
      "tar": "^7.5.21",
      "sharp": "^0.35.0"
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "pg": "^8.20.0"
  },
  "packageManager": "pnpm@10.33.0"
}
