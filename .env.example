# SMT Verification System — environment template
# Copy to `.env` and fill in real values. NEVER commit a filled-in .env.
# Secrets must be at least 32 characters. Generate with: openssl rand -hex 32

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://smt_user:CHANGE_ME@localhost:5432/smt

# ── Auth / signing secrets (JWT_SECRET must differ from JWT_ADMIN_SECRET) ──
JWT_SECRET=change-me-32-char-minimum-random-secret
JWT_ADMIN_SECRET=change-me-different-32-char-admin-secret
AUDIT_HMAC_SECRET=change-me-32-char-audit-log-hmac-secret
QR_SIGNING_KEY=change-me-32-char-qr-signing-secret
VITE_LICENSE_HMAC_KEY=change-me-32-char-license-hmac-secret

# ── Admin portal ──────────────────────────────────────────
ADMIN_PORTAL_PATH=/admin-portal-change-me
ADMIN_USERNAME=admin
# bcrypt hash of the admin password — generate, do not store plaintext
ADMIN_PASSWORD_HASH=$2b$12$replace_with_real_bcrypt_hash
ADMIN_IP_ALLOWLIST=

# ── Server ────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# COOKIE_SECURE=false drops the Secure cookie flag for LAN-over-HTTP installs
# (browsers refuse Secure cookies over plain http). Set to true behind TLS.
COOKIE_SECURE=false
# TRUST_PROXY: leave UNSET for a direct-LAN deploy. Set it ("true", a hop count,
# or an IP/subnet) ONLY when a real reverse proxy that overwrites X-Forwarded-For
# sits in front — it makes req.ip (and the Module 10 device allow-list) trust that
# header. STARTUP GATE (intentional, not a bug): the server REFUSES to start if
# TRUST_PROXY is active AND COOKIE_SECURE=false, because a spoofable X-Forwarded-For
# plus plaintext cookies defeats device restriction. To run behind a proxy, also
# set COOKIE_SECURE=true; for direct LAN, leave TRUST_PROXY unset.
# TRUST_PROXY=
SERVE_STATIC=true
ALLOWED_ORIGINS=http://localhost:5173
TZ=Asia/Kolkata

# ── Company branding ──────────────────────────────────────
COMPANY_NAME=UCAL ELECTRONICS PVT.LTD.
COMPANY_LOGO_PATH=

# ── Shift windows (start hour, 24h local time) ────────────
SHIFT_MORNING_START=6
SHIFT_AFTERNOON_START=14
SHIFT_NIGHT_START=22

# ── Limits ────────────────────────────────────────────────
DB_MAX_SIZE_MB=5000
JOB_QUEUE_MAX_DEPTH=50

# ── Backups ───────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ── Report archive (Module 15b) ────────────────────────────
# Absolute path the API writes rendered session reports to, as
# <root>/<year>/<month>/<session>/. FALLBACK ONLY: Admin Portal > Report Output
# stores the same setting in the DB and that value wins whenever archiving is
# enabled there. Leave unset to configure it entirely from the dashboard.
# Under systemd, ProtectSystem=strict makes any path outside the unit's
# ReadWritePaths read-only — add the root you choose there too.
# REPORT_ARCHIVE_ROOT=

# ── Optional integrations ─────────────────────────────────
ANTHROPIC_API_KEY=

# ── Seed passwords (dev/test only — used by the seed script) ──
SEED_OPERATOR_PASSWORD=change-me
SEED_QA_PASSWORD=change-me
SEED_SUPERVISOR_PASSWORD=change-me
SEED_ADMIN_PASSWORD=change-me
SEED_STORE_PASSWORD=change-me
