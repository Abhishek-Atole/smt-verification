{
  "name": "infizent-technology-suite",
  "productName": "Infizent Technology",
  "description": "Infizent Technology — Production Line Management Suite",
  "version": "1.0.0",
  "author": "Abhishek Himmatrao Atole",
  "copyright": "Copyright © 2026 Abhishek Himmatrao Atole. All rights reserved.",
  "homepage": "https://infizent.com",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "PORT=5173 vite build --config vite.config.ts",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:electron:prod": "BUILD_TARGET=electron PORT=5173 vite build --config vite.config.ts && tsc -p electron/tsconfig.json",
    "copy:api-server": "rsync -av --delete ../api-server/dist/ api-server/ && rsync -av --delete ../api-server/package.json api-server/package.json && rsync -avL --delete ../api-server/node_modules/ api-server/node_modules/",
    "dist": "npm run copy:api-server && npm run build:electron:prod && electron-builder --win",
    "dist:linux": "npm run copy:api-server && npm run build:electron:prod && electron-builder --linux",
    "dist:all": "npm run copy:api-server && npm run build:electron:prod && electron-builder --win --linux",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -b --force ../../lib/api-client-react && tsc -p tsconfig.json --noEmit",
    "test": "PORT=3000 vitest run",
    "test:unit": "PORT=3000 vitest run"
  },
  "devDependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "catalog:",
    "@types/papaparse": "^5.5.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@workspace/api-client-react": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "date-fns": "^3.6.0",
    "electron": "^42.10.1",
    "electron-builder": "^26.15.3",
    "framer-motion": "catalog:",
    "jsdom": "^29.0.2",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.55.0",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vite": "catalog:",
    "vitest": "^4.1.5",
    "wouter": "^3.3.5",
    "zod": "catalog:"
  },
  "dependencies": {
    "bwip-js": "4.11.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "node-machine-id": "^1.1.12",
    "papaparse": "^5.5.3",
    "zustand": "^5.0.12"
  },
  "build": {
    "appId": "com.infizenttechnology.suite",
    "productName": "Infizent Technology",
    "copyright": "Copyright © 2026 Abhishek Himmatrao Atole. All rights reserved.",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "api-server/**/*",
      "api-server/node_modules/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "api-server/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Infizent Technology"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Development",
      "maintainer": "Abhishek Himmatrao Atole <abhishek@infizent.com>",
      "description": "Infizent Technology — Production Line Management Suite",
      "executableName": "infizent-technology"
    },
    "deb": {
      "depends": [
        "libnss3",
        "libatk1.0-0",
        "libatk-bridge2.0-0",
        "libcups2",
        "libdrm2",
        "libgbm1",
        "libasound2",
        "libxcomposite1",
        "libxdamage1",
        "libxrandr2",
        "libxkbcommon0",
        "libpango-1.0-0",
        "libcairo2",
        "libgtk-3-0"
      ]
    }
  }
}
